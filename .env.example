# Copied to .env.local by pnpm bootstrap. Nothing here is a secret.
# Real values live in the host environment and are never committed.

# Stamped by the deployment, read by /api/health. Empty locally is expected.
TANUKITSUNE_COMMIT=
TANUKITSUNE_BUILT_AT=

# A personal access token from wanikani.com/settings/personal_access_tokens. Read is
# enough to review; the flush submits, so it needs the assignment write scope too.
# Unset serves the demo deck instead, which is what one public URL being both the demo
# and the product means. Set it to review a real account.
# WANIKANI_TOKEN=

# Set to on, and to nothing else, for the flush to submit to WaniKani. A submission is
# irreversible and they offer no sandbox, so absent is off and so is every other value.
# TANUKITSUNE_UPSTREAM_WRITE=

# What the backup route requires of a caller, any long random string. Unset closes that
# route, so answers stay in the browser rather than reaching a route open to anyone.
# TANUKITSUNE_SYNC_SECRET=

# Unset locally: the app opens a file-backed Postgres in .postgres instead.
# Set in a deployment, where opening the local store would be a silent outage.
# Commented rather than assigned nothing, because bootstrap copies this file as the
# local environment and a variable is better absent than empty for every tool that
# has not been taught the difference.
# DATABASE_URL=

# Which directory that file-backed Postgres opens. Left unset here on purpose: it separates
# two servers only when named on one server's command, and assigned here both would read it.
# The end-to-end suite sets it for its second server. Keep the .postgres prefix, which is what
# .gitignore holds.
# TANUKITSUNE_LOCAL_DATABASE=
