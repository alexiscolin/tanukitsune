# Copied to .env.local by pnpm bootstrap. Nothing here is a secret.
# Real values live in the host environment and are never committed.

# Stamped by the deployment, read by /api/health. Empty locally is expected.
TANUKITSUNE_COMMIT=
TANUKITSUNE_BUILT_AT=

# Unset locally: the app opens a file-backed Postgres in .postgres instead.
# Set in a deployment, where opening the local store would be a silent outage.
# Commented rather than left empty, because assigning nothing is not the same as
# not assigning, and bootstrap copies this file as the local one.
# DATABASE_URL=
