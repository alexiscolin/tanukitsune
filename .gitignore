CLAUDE.local.md
.DS_Store
*.tsbuildinfo

# Human-only material: personal notes, learning references, working protocol.
# Not part of the project. Never committed.
info/

# Local file-backed Postgres, created by pnpm bootstrap.
# Every database the file-backed driver opens, by prefix: it writes binary the repository must never
# carry, and the directory is named by a variable, so the prefix is what src/data/local-data-dir.ts
# constrains a caller to.
.postgres*

# Playwright output.
test-results/
playwright-report/

# Storybook build output.
storybook-static/

# Their meanings and their identifiers, fetched to prove coverage and kept off every published surface.
corpus/.inventory.json

# The batch a naming run left in flight. It names a job on somebody's account and the next run
# replaces it, so it belongs to the machine that submitted rather than to the language.
corpus/*/.naming-batch.json
corpus/*/.key-choice-batch.json
corpus/*/.key-translation-batch.json
