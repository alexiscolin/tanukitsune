{
  "name": "tanukitsune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc6 --noEmit",
    "lint": "eslint .",
    "arch": "depcruise src && bash scripts/check-boundaries.sh",
    "knip": "knip",
    "dupes": "jscpd src",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:docs": "bash scripts/check-docs.sh",
    "check:review": "bash scripts/check-review-coverage-probe.sh",
    "check:sketches": "bash scripts/check-sketches.sh",
    "check:tests": "bash scripts/check-test-strength-probe.sh",
    "check:tokens": "bash scripts/check-tokens.sh",
    "gate": "pnpm check:contrast && pnpm typecheck && pnpm check:docs && pnpm arch && pnpm lint",
    "verify": "pnpm gate && pnpm check:sketches && pnpm check:tokens && pnpm check:review && pnpm check:tests && pnpm build && pnpm test && pnpm knip && pnpm dupes",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "wanakana": "5.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.0",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "5.0.14",
    "jsdom": "30.0.1",
    "knip": "6.29.0",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
